# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in Codespaces secrets or Vercel environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Shared Supabase project used by this application.
VITE_SUPABASE_URL="https://lqtwchfquemarmzanzqt.supabase.co"
# Set this to the project's anon/publishable key in Vercel/Codespaces Secrets.
# Never put a service_role or secret key in this file or browser code.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
